{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vityo.dev/schema/vityod-v1.schema.json",
  "title": "Vityo daemon control envelope",
  "type": "object",
  "required": [
    "protocolVersion",
    "method",
    "clientInstanceId",
    "idempotencyKey",
    "deadlineUnixMillis",
    "params",
    "capabilities"
  ],
  "properties": {
    "protocolVersion": {"const": 1},
    "method": {"type": "string", "minLength": 1},
    "requestId": {"type": "string"},
    "clientInstanceId": {"type": "string", "minLength": 1},
    "idempotencyKey": {"type": "string", "minLength": 1},
    "workspaceId": {"type": "string"},
    "workspaceRevision": {"type": "integer", "minimum": 0},
    "deadlineUnixMillis": {"type": "integer", "minimum": 0},
    "cancellationId": {"type": "string"},
    "params": {"type": "object"},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
