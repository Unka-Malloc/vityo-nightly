{
  "schema_version": 1,
  "surface": "Vityo.toolchain-backend",
  "note": "Non-normative example for local mocks. Product-contract truth lives in docs/contracts/ and upstream repo contracts.",
  "workspace": {
    "workspace_id": null,
    "project_root": "/workspace/demo"
  },
  "route": {
    "kind": "local-cli",
    "hosted_control_plane": false
  },
  "upstream_sources": {
    "styio": {
      "authority": "system compiler and machine-contract SSOT",
      "command": "styio --machine-info=json"
    },
    "pafio": {
      "authority": "local project metadata and workflow SSOT",
      "command": "pafio metadata --json"
    },
    "styio_platform": {
      "authority": "Platform hosted-workspace v1",
      "workspace_id": null
    }
  },
  "profiles": {
    "android": {
      "default": "android-36",
      "selected": "android-36"
    },
    "apple": {
      "ios_default": "ios-13",
      "macos_default": "macos-10.15"
    }
  },
  "toolchain_state": {
    "status": "partial",
    "compiler_version": "0.0.0-nightly.20260421",
    "channel": "nightly",
    "source": "system-styio"
  },
  "capabilities": {
    "metadata": true,
    "workflow_json": true,
    "styio_machine_info": true,
    "hosted_workspace": false
  },
  "blocked_reasons": [
    {
      "code": "hosted-workspace-unavailable",
      "message": "Hosted workspace identity is missing, so Platform hosted routes remain blocked."
    }
  ]
}
