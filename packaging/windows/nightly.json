{
  "schema_version": 1,
  "platform": "windows",
  "product": "vityo",
  "package_format": "zip-powershell",
  "build_relative_path": "products/vityo_app/build/windows/x64/runner/Release",
  "icon_relative_path": "products/vityo_app/windows/runner/resources/app_icon.ico",
  "installer_definition": "packaging/windows/install.ps1",
  "uninstaller_definition": "packaging/windows/uninstall.ps1",
  "windows_pipe": {
    "package_relative_path": "vityo_windows_pipe.dll",
    "abi_version": 1
  },
  "vityod": {
    "target": "x86_64-pc-windows-msvc",
    "source_relative_path": "products/vityo_app/native/vityod/target/release/vityod.exe",
    "package_relative_path": "components/vityod.exe",
    "required_runtime_libraries": ["vcruntime140.dll"]
  },
  "coding_agent": {
    "target": "x86_64-pc-windows-msvc",
    "source_relative_path": "products/vityo_coding_agent/target/release/vityo-coding-agent.exe",
    "package_relative_path": "components/vityo-coding-agent.exe",
    "required_runtime_libraries": ["vcruntime140.dll"]
  },
  "pafio": {
    "target": "x86_64-pc-windows-msvc",
    "package_relative_path": "components/pafio.exe",
    "required_runtime_libraries": ["vcruntime140.dll"],
    "manifest_relative_path": "components/pafio-component.json"
  },
  "rust_notices_path": "licenses/RUST-THIRD-PARTY-NOTICES.txt",
  "signing": {"status": "explicit-gap", "reason": "Nightly Authenticode signing credentials are not configured."},
  "automatic_updates": false
}
